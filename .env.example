# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_website?schema=public"

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=LTWork <noreply@yourdomain.com>

# CORS (phân cách nhiều origin bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
