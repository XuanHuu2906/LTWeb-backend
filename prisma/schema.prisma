generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Module 1: Accounts & Auth ─────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String // candidate | recruiter | admin | pending
  status       String    @default("active") // active | inactive | banned
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  candidateProfile         CandidateProfile?
  recruiterProfile         RecruiterProfile?
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  cvTemplatesCreated  CVTemplate[]
  cvs                 CV[]
  savedJobs           SavedJob[]
  jobViews            JobView[]
  jobPostings         JobPosting[]
  notifications       Notification[]
  messages            Message[]
  auditLogs           AuditLog[]

  @@map("users")
}

model CandidateProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  fullName          String    @map("full_name")
  phone             String?
  address           String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  avatarUrl         String?   @map("avatar_url")
  avatarStoragePath String?   @map("avatar_storage_path")
  bio               String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications  Application[]
  conversations Conversation[] @relation("candidateConversations")

  @@map("candidate_profiles")
}

model RecruiterProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  companyName     String   @map("company_name")
  contactName     String?  @map("contact_name")
  phone           String?
  address         String?
  website         String?
  description     String?
  logoUrl         String?  @map("logo_url")
  logoStoragePath String?  @map("logo_storage_path")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations          Conversation[]          @relation("recruiterConversations")
  applicationFeedbacks   ApplicationFeedback[]
  applicationEvaluations ApplicationEvaluation[]

  @@map("recruiter_profiles")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ── Module 2: CV Templates & CVs ───────────────────────────────────────────

model CVTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  layoutConfig String?  @map("layout_config")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id])
  cvs     CV[]

  @@index([isActive])
  @@map("cv_templates")
}

model CV {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  templateId     Int?      @map("template_id")
  title          String    @default("CV của tôi")
  status         String    @default("draft") // draft | active
  cvType         String    @map("cv_type") // built | uploaded
  personalInfo   String?   @map("personal_info")
  education      String?
  experience     String?
  skills         String?
  certifications String?
  projects       String?
  pdfUrl         String?   @map("pdf_url")
  pdfStoragePath String?   @map("pdf_storage_path")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     CVTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("cvs")
}

// ── Module 3: Job Postings ─────────────────────────────────────────────────

model JobCategory {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  parent      JobCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    JobCategory[] @relation("CategoryHierarchy")
  jobPostings JobPosting[]

  @@index([parentId])
  @@map("job_categories")
}

model JobPosting {
  id              Int       @id @default(autoincrement())
  recruiterId     Int       @map("recruiter_id")
  categoryId      Int?      @map("category_id")
  title           String
  description     String
  requirements    String?
  benefits        String?
  location        String?
  salaryMin       Decimal?  @map("salary_min") @db.Decimal(15, 2)
  salaryMax       Decimal?  @map("salary_max") @db.Decimal(15, 2)
  salaryUnit      String?   @map("salary_unit")
  jobType         String    @map("job_type")
  experienceLevel String?   @map("experience_level")
  status          String    @default("CHO_DUYET")
  expiresAt       DateTime? @map("expires_at") @db.Date
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  rejectionReason String?   @map("rejection_reason")

  recruiter     User              @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  category      JobCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  applications  Application[]
  savedJobs     SavedJob[]
  jobViews      JobView[]
  skills        JobPostingSkill[]
  conversations Conversation[]

  @@index([recruiterId])
  @@index([status])
  @@index([title])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("job_postings")
}

model SavedJob {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  jobPostingId Int      @map("job_posting_id")
  savedAt      DateTime @default(now()) @map("saved_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@map("saved_jobs")
}

model JobView {
  id           Int      @id @default(autoincrement())
  jobPostingId Int      @map("job_posting_id")
  viewerId     Int?     @map("viewer_id")
  viewerIp     String?  @map("viewer_ip")
  viewedAt     DateTime @default(now()) @map("viewed_at")

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  viewer     User?      @relation(fields: [viewerId], references: [id])

  @@index([jobPostingId])
  @@index([viewedAt])
  @@map("job_views")
}

model JobSkill {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  jobPostings JobPostingSkill[]

  @@map("job_skills")
}

model JobPostingSkill {
  jobPostingId Int @map("job_posting_id")
  skillId      Int @map("skill_id")

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill      JobSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPostingId, skillId])
  @@map("job_posting_skills")
}

// ── Module 4: Applications ────────────────────────────────────────────────

model Application {
  id                 Int       @id @default(autoincrement())
  candidateProfileId Int       @map("candidate_profile_id")
  jobPostingId       Int       @map("job_posting_id")
  cvId               Int       @map("cv_id")
  coverLetter        String?   @map("cover_letter")
  status             String    @default("pending")
  deletedAt          DateTime? @map("deleted_at")
  appliedAt          DateTime  @default(now()) @map("applied_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  candidateProfile CandidateProfile        @relation(fields: [candidateProfileId], references: [id])
  jobPosting       JobPosting              @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  cv               CV                      @relation(fields: [cvId], references: [id])
  feedbacks        ApplicationFeedback[]
  evaluations      ApplicationEvaluation[]
  interviews       Interview[]

  @@unique([candidateProfileId, jobPostingId])
  @@index([candidateProfileId])
  @@index([jobPostingId])
  @@index([status])
  @@index([deletedAt])
  @@map("applications")
}

model ApplicationFeedback {
  id                 Int      @id @default(autoincrement())
  applicationId      Int      @map("application_id")
  recruiterProfileId Int      @map("recruiter_profile_id")
  content            String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiterProfile RecruiterProfile @relation(fields: [recruiterProfileId], references: [id])

  @@index([applicationId])
  @@map("application_feedbacks")
}

model ApplicationEvaluation {
  id                 Int      @id @default(autoincrement())
  applicationId      Int      @unique @map("application_id")
  recruiterProfileId Int      @map("recruiter_profile_id")
  score              Int?     @db.SmallInt
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiterProfile RecruiterProfile @relation(fields: [recruiterProfileId], references: [id])

  @@map("application_evaluations")
}

model Interview {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  scheduledAt   DateTime  @map("scheduled_at")
  type          String    // online | offline
  location      String?
  notes         String?
  status        String    @default("scheduled") // scheduled | confirmed | cancelled | completed
  confirmedAt   DateTime? @map("confirmed_at")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interviews")
}

// ── Module 5: Notifications ───────────────────────────────────────────────

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String
  title       String
  message     String
  relatedType String?  @map("related_type")
  relatedId   Int?     @map("related_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

// ── Module 6: Chat ────────────────────────────────────────────────────────

model Conversation {
  id                 Int      @id @default(autoincrement())
  candidateProfileId Int      @map("candidate_profile_id")
  recruiterProfileId Int      @map("recruiter_profile_id")
  jobPostingId       Int?     @map("job_posting_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  candidateProfile CandidateProfile @relation("candidateConversations", fields: [candidateProfileId], references: [id])
  recruiterProfile RecruiterProfile @relation("recruiterConversations", fields: [recruiterProfileId], references: [id])
  jobPosting       JobPosting?      @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@unique([candidateProfileId, recruiterProfileId, jobPostingId])
  @@index([candidateProfileId])
  @@index([recruiterProfileId])
  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  senderId       Int      @map("sender_id")
  content        String?
  messageType    String   @default("text") @map("message_type")
  attachmentPath String?  @map("attachment_path")
  attachmentName String?  @map("attachment_name")
  attachmentMime String?  @map("attachment_mime")
  attachmentSize Int?     @map("attachment_size")
  isRead         Boolean  @default(false) @map("is_read")
  sentAt         DateTime @default(now()) @map("sent_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([sentAt])
  @@map("messages")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  action     String // e.g. "delete_user", "toggle_user_status", "force_delete_job"
  targetType String   @map("target_type") // e.g. "user", "job_posting"
  targetId   Int      @map("target_id")
  details    String? // Thông tin chi tiết (JSON string)
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model HomeFeature {
  id          Int      @id @default(autoincrement())
  icon        String
  title       String
  description String
  highlight   String
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([order])
  @@map("home_features")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  avatar    String?
  content   String
  rating    Int      @default(5) @db.SmallInt
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([order])
  @@map("testimonials")
}

model SiteMetric {
  id        Int      @id @default(autoincrement())
  value     String
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([order])
  @@map("site_metrics")
}
